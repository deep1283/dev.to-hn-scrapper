# App URL used by payment providers and redirects
APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Clerk auth (optional, required when migrating off Supabase Auth)
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in

# Supabase server credentials (do not expose in client bundles)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Mentions worker dispatch (GitHub Actions workflow_dispatch)
MENTION_BOOTSTRAP_GITHUB_TOKEN=
MENTION_BOOTSTRAP_GITHUB_OWNER=
MENTION_BOOTSTRAP_GITHUB_REPO=
MENTION_BOOTSTRAP_GITHUB_WORKFLOW=mentions-worker.yml
MENTION_BOOTSTRAP_GITHUB_REF=main
MENTION_BOOTSTRAP_GITHUB_API_BASE_URL=https://api.github.com

# Optional run-now webhook entrypoint (for onboarding)
# Example: https://your-domain.com/api/cron/mentions
MENTION_BOOTSTRAP_WEBHOOK_URL=
MENTION_BOOTSTRAP_WEBHOOK_TOKEN=
MENTION_BOOTSTRAP_WEBHOOK_TIMEOUT_MS=4000

# External scheduler token (cron-jobs.org -> /api/cron/mentions)
# If empty, /api/cron/mentions falls back to MENTION_BOOTSTRAP_WEBHOOK_TOKEN.
CRON_MENTIONS_TOKEN=

# Dodo Payments API checkout configuration
DODO_PAYMENTS_API_KEY=
# Use https://test.dodopayments.com in test mode and https://live.dodopayments.com in live mode
DODO_PAYMENTS_MODE=live
DODO_API_BASE_URL=https://live.dodopayments.com
# The app code reads these product IDs
DODO_PRODUCT_ID_PLUS=
DODO_PRODUCT_ID_PRO=

# Dodo webhook verification secret
DODO_PAYMENTS_WEBHOOK_SECRET=

# Resend transactional email
RESEND_API_KEY=
RESEND_FROM_EMAIL=
# Optional: automatically upsert contacts into a Resend audience after send
RESEND_AUDIENCE_ID=
# Optional: internal inbox for pilot request notifications
RESEND_PILOT_REQUEST_TO_EMAIL=

# Telegram bot integration
TELEGRAM_BOT_TOKEN=
# Optional but recommended: verify incoming Telegram webhook requests
TELEGRAM_WEBHOOK_SECRET=
# Minimum delay between Telegram alert digests for the same user
TELEGRAM_ALERT_COOLDOWN_MINUTES=180

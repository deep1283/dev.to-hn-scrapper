# Public URL for post-checkout returns
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_URL=http://localhost:3000

# Supabase server credentials (required by backend API routes)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional public Supabase values (only needed for legacy utils)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Dodo API checkout configuration
DODO_PAYMENTS_API_KEY=
DODO_PAYMENTS_MODE=test
DODO_API_BASE_URL=https://test.dodopayments.com

# Either pair is accepted by current checkout route
DODO_PLUS_PRODUCT_ID=
DODO_PRO_PRODUCT_ID=
DODO_PRODUCT_ID_PLUS=
DODO_PRODUCT_ID_PRO=

# Either webhook secret key is accepted
DODO_WEBHOOK_SECRET=
DODO_PAYMENTS_WEBHOOK_SECRET=

# Optional onboarding bootstrap hook (server-side only)
# When set, onboarding completion can trigger an immediate worker run via this URL.
MENTION_BOOTSTRAP_WEBHOOK_URL=
MENTION_BOOTSTRAP_WEBHOOK_TOKEN=
MENTION_BOOTSTRAP_WEBHOOK_TIMEOUT_MS=4000

# Optional: trigger GitHub Actions worker immediately (instead of waiting for schedule)
# If these are set, onboarding/keyword activation can dispatch the workflow directly.
MENTION_BOOTSTRAP_GITHUB_TOKEN=
MENTION_BOOTSTRAP_GITHUB_OWNER=
MENTION_BOOTSTRAP_GITHUB_REPO=
MENTION_BOOTSTRAP_GITHUB_WORKFLOW=mentions-worker.yml
MENTION_BOOTSTRAP_GITHUB_REF=main
MENTION_BOOTSTRAP_GITHUB_API_BASE_URL=https://api.github.com
